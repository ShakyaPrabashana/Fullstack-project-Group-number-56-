# CampusBook — template for .env.fullstack
#
# Copy this file to .env.fullstack and fill in real values:
#     cp .env.fullstack.example .env.fullstack
#
# .env.fullstack is git-ignored and docker-ignored. This template is safe to
# commit because it contains no real credentials — keep it that way.

# ---- Database ----
# Local MongoDB. Use mongodb://mongo:27017/campusbook when running via Docker
# Compose, because there the database is reachable by service name, not localhost.
MONGO_URL=mongodb://localhost:27017/campusbook

# Separate database for the test suite. The tests delete every collection after
# each test, so this MUST NOT be the same database as MONGO_URL.
MONGO_URL_TEST=mongodb://localhost:27017/campusbook_test

# ---- Auth ----
# Generate a strong one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ---- Server ----
PORT=8080
NODE_ENV=development
